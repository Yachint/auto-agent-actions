{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-agent-actions.local/schemas/review-output.json",
  "title": "Codex pull request review output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings", "summary", "blocked_reason"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked"],
      "description": "Use completed only after the exact diff was inspected; otherwise use blocked."
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body",
          "priority",
          "confidence",
          "path",
          "start_line",
          "end_line"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "A short, specific statement of the defect, without a priority prefix."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "A compact explanation of the trigger, impact, code evidence, and remediation direction."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "0=P0 catastrophic, 1=P1 serious merge blocker, 2=P2 meaningful contained defect, 3=P3 low-impact real defect."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Calibrated confidence in the causal claim; findings below 0.80 should be omitted."
          },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "blocked_reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1000,
      "description": "Null for completed reviews; a concise reason for blocked reviews."
    }
  }
}
